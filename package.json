{
  "name": "labelmatrix-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Universal product back-label design, barcode generator and QR code generator",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec npx webpack serve --mode development",
    "start": "webpack serve --mode development --open",
    "build": "webpack --mode production",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"public/**/*.{html}\" \"*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"public/**/*.{html}\" \"*.js\""
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jquery": "^3.7.1",
    "jsbarcode": "^3.11.6",
    "jspdf": "^2.5.2",
    "nodemon": "^3.1.14",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "babel-loader": "^9.2.1",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "nodemon-webpack-plugin": "^4.8.2",
    "prettier": "^3.4.2",
    "style-loader": "^4.0.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  }
}
